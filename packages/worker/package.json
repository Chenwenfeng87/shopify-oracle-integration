{
  "name": "@shopify-oracle/worker",
  "version": "1.0.0",
  "private": true,
  "description": "Background worker for Shopify-Oracle integration sync jobs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/index.js",
    "test": "jest --config jest.config.js"
  },
  "dependencies": {
    "amqplib": "^0.10.4",
    "pg": "^8.12.0",
    "ioredis": "^5.4.1",
