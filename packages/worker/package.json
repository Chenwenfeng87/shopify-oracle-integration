    "axios": "^1.7.2"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/pg": "^8.11.6",
    "@types/uuid": "^10.0.0",
    "@types/node": "^20.14.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.5",
    "@types/jest": "^29.5.12"
  }
}
